        {
          "name": "Get Wallet Mutations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is paginated mutation history', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.page).to.be.a('number');",
                  "  pm.expect(body.size).to.be.a('number');",
                  "  pm.expect(body.total_items).to.be.a('number');",
                  "  pm.expect(body.total_pages).to.be.a('number');",
                  "  pm.expect(body.items).to.be.an('array');",
                  "});"
                ]
              }
