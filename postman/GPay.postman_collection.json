        {
          "name": "Transfer Wallet",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has transfer details', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.transfer_id).to.be.a('string');",
                  "  pm.expect(body.sender_wallet_id).to.be.a('string');",
                  "  pm.expect(body.receiver_wallet_id).to.be.a('string');",
                  "  pm.expect(body.amount).to.be.a('number');",
                  "  pm.expect(body.status).to.eql('SUCCESS');",
                  "  pm.expect(body.created_at).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Idempotency-Key", "value": "transfer-{{$guid}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{wallet_url}}/wallets/transfer",
              "host": ["{{wallet_url}}"],
              "path": ["wallets", "transfer"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver_wallet_id\": \"{{receiver_wallet_id}}\",\n  \"amount\": 25000\n}"
            },
            "description": "Transfers whole-IDR balance from the authenticated user's wallet to receiver_wallet_id. Requires a valid Bearer access token and Idempotency-Key."
          }
        },
