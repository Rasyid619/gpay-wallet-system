{
  "info": {
    "name": "GPay Wallet System",
    "_postman_id": "gpay-wallet-system-v1",
    "description": "Postman collection for GPay Wallet System microservices.\n\nServices:\n- Auth Service: http://localhost:8081\n- Wallet Service: http://localhost:8082\n- Payment Service: http://localhost:8083\n- Mock Gateway Service: http://localhost:8084\n\nUsage:\n1. Register a user via POST /auth/register\n2. Login via POST /auth/login — access_token is auto-saved to the `access_token` variable\n3. Use {{access_token}} in Authorization headers for protected endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "auth_url",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "wallet_url",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "payment_url",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "gateway_url",
      "value": "http://localhost:8084",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "receiver_wallet_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "internal_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "credit_wallet_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "payment_transaction_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Response has user_id and email', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user_id).to.be.a('string');",
                  "  pm.expect(body.email).to.be.a('string');",
                  "  pm.expect(body.created_at).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/register",
              "host": ["{{auth_url}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "description": "Register a new user. Returns 201 Created with user_id, email, and created_at. Password is never returned."
          }
        },
        {
          "name": "Register — Duplicate Email (expect 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 409', () => pm.response.to.have.status(409));",
                  "pm.test('Error code is EMAIL_ALREADY_REGISTERED', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.eql('EMAIL_ALREADY_REGISTERED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/register",
              "host": ["{{auth_url}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "description": "Expected: 409 Conflict with error EMAIL_ALREADY_REGISTERED when email is already taken."
          }
        },
        {
          "name": "Register — Invalid Email (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is VALIDATION_ERROR', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/register",
              "host": ["{{auth_url}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"password123\"\n}"
            },
            "description": "Expected: 400 Bad Request with error VALIDATION_ERROR when email format is invalid."
          }
        },
        {
          "name": "Register — Weak Password (expect 400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error code is VALIDATION_ERROR', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.eql('VALIDATION_ERROR');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/register",
              "host": ["{{auth_url}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user2@example.com\",\n  \"password\": \"weakpass\"\n}"
            },
            "description": "Expected: 400 Bad Request when password lacks uppercase, digit, or special character."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/login",
              "host": ["{{auth_url}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "description": "Login with email and password. Returns access_token (15 min) and refresh_token (7 days). The test script auto-saves both tokens to collection variables."
          }
        },
        {
          "name": "Login — Wrong Password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/login",
              "host": ["{{auth_url}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "description": "Expected: 401 Unauthorized with error UNAUTHORIZED."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has access_token and refresh_token', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.access_token).to.be.a('string');",
                  "  pm.expect(body.refresh_token).to.be.a('string');",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/refresh",
              "host": ["{{auth_url}}"],
              "path": ["auth", "refresh"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "description": "Exchange a valid refresh token for a new access token and refresh token (token rotation). The old refresh token is revoked. Tokens are auto-saved to collection variables."
          }
        },
        {
          "name": "Refresh Token — Invalid Token (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error is UNAUTHORIZED', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.error).to.eql('UNAUTHORIZED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/refresh",
              "host": ["{{auth_url}}"],
              "path": ["auth", "refresh"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"invalid-or-unknown-token-value\"\n}"
            },
            "description": "Expected: 401 Unauthorized when refresh token is unknown, expired, or revoked."
          }
        },
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has user_id, email, role, created_at', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.user_id).to.be.a('string');",
                  "  pm.expect(body.email).to.be.a('string');",
                  "  pm.expect(body.role).to.be.a('string');",
                  "  pm.expect(body.created_at).to.be.a('string');",
                  "});",
                  "pm.test('Password hash is not exposed', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.not.have.property('password_hash');",
                  "  pm.expect(body).to.not.have.property('password');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/me",
              "host": ["{{auth_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns the authenticated user's profile (user_id, email, role, created_at). Requires a valid Bearer access token."
          }
        },
        {
          "name": "Get Current User — No Token (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{auth_url}}/auth/me",
              "host": ["{{auth_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Expected: 401 Unauthorized when Authorization header is missing."
          }
        },
        {
          "name": "Get Current User — Invalid Token (expect 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer invalid.token.here" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/me",
              "host": ["{{auth_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Expected: 401 Unauthorized when token is invalid or expired."
          }
        }
      ]
    },
    {
