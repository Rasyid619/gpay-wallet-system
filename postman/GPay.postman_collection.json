{
  "info": {
    "name": "GPay Wallet System",
    "_postman_id": "gpay-wallet-system-v1",
    "description": "Postman collection for GPay Wallet System microservices.\n\nServices:\n- Auth Service: http://localhost:8081\n- Wallet Service: http://localhost:8082\n- Payment Service: http://localhost:8083\n- Mock Gateway Service: http://localhost:8084\n\nUsage:\n1. Register a user via POST /auth/register\n2. Login via POST /auth/login — access_token is auto-saved to the `access_token` variable\n3. Use {{access_token}} in Authorization headers for protected endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "auth_url",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "wallet_url",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "payment_url",
      "value": "http://localhost:8083",
      "type": "string"
    },
    {
      "key": "gateway_url",
      "value": "http://localhost:8084",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "refresh_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/register",
              "host": ["{{auth_url}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "description": "Register a new user. Returns 201 Created on success, 409 Conflict on duplicate email."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/login",
              "host": ["{{auth_url}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "description": "Login with email and password. Returns access_token (15 min) and refresh_token (7 days). The test script auto-saves both tokens to collection variables."
          }
        },
        {
          "name": "Login — Wrong Password (expect 401)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/login",
              "host": ["{{auth_url}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "description": "Expected: 401 Unauthorized with error UNAUTHORIZED."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('access_token', body.access_token);",
                  "  pm.collectionVariables.set('refresh_token', body.refresh_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/refresh",
              "host": ["{{auth_url}}"],
              "path": ["auth", "refresh"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
            },
            "description": "Exchange a valid refresh token for a new access token and refresh token."
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{auth_url}}/auth/me",
              "host": ["{{auth_url}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns the authenticated user's profile. Requires a valid access token."
          }
        }
      ]
    }
  ]
}
